{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "derbytime",
      "runtimeExecutable": ".venv/Scripts/derbytime.exe",
      "runtimeArgs": ["serve", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "derbytime-worktree",
      "runtimeExecutable": "../../../.venv/Scripts/python.exe",
      "runtimeArgs": ["-c", "import sys; sys.path.insert(0, 'src'); from derbytime.cli import main; sys.exit(main())", "serve", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001
    }
  ]
}
